// ─── ui/registry.resid — a web UI for a resid registry ─────────────────
// Browse a registry directory (ui/store.resid reads it) in a browser,
// driven by Datastar:
//
//   /                              packages, searched as you type
//   /pkg/<name>?v=&tab=&file=      one version: Readme, Manifest, Files,
//                                  Dependencies (direct, transitive, used
//                                  by) and Diff against another version
//   /raw/<name>/<ver>/<path>       one file as text
//   /download/<name>/<ver>         the archive
//
// Pages stay live: each opens a stream that watches the registry and has
// the page fetch what changed, so a publish shows up without a reload.
//
//   resid-registry-ui <registry> [--port N] [--port-file F] [--pubkey HEX]
//                     [--cdn] [--poll-ms N] [--requests N]
//
// With --pubkey the index and every archive signature are verified
// against that key; without it they are only reported present. The
// server binds 127.0.0.1, reads the registry and never writes it.

import "../src/datastar.resid";
import "store.resid";
import "manifest.resid";
import "markdown.resid";
import "diff.resid";

type Opts = { Str root; Int port; Str port_file; Str pubkey; Bool cdn; Int poll_ms; Int requests; Bool ok; };

// ─── Markup helpers ─────────────────────────────────────────────────────

Str esc(Str s) { return ds_escape_html(s); }

Str attr(Str s) { return ds_escape_attr(s); }

// A path percent-encoded: nothing in it can end a URL, a quote or an
// attribute. `/` is kept.
Str pct(Str s) { return pct_at(http_bytes(s), 0, StrBuf()); }

Str pct_at(List(Int) b, Int i, StrBuf acc) {
    if (i >= b.len()) { return acc.finish(); }
    Int c = b[i];
    Bool plain = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 95 || c == 126 || c == 47;
    StrBuf next = if (plain) { acc.push_char(c) } else { acc.push("%").push(hex2(c)) };
    return pct_at(b, i + 1, next);
}

Str hex2(Int c) {
    Str d = "0123456789ABCDEF";
    return str_slice(d, c / 16, c / 16 + 1) + str_slice(d, c % 16, c % 16 + 1);
}

// A Datastar action that GETs `url` (already percent-encoded).
Str get(Str url) { return "@get('" + url + "')"; }

Str size_text(Int n) {
    if (n < 1024) { return f"{n} B"; }
    if (n < 1048576) { return f"{n / 1024}.{(n % 1024) * 10 / 1024} KiB"; }
    return f"{n / 1048576}.{(n % 1048576) * 10 / 1048576} MiB";
}

Str badge(Str kind, Str text) { return "<span class=\"badge " + kind + "\">" + esc(text) + "</span>"; }

Str index_badge(IndexState s) {
    Str kind = if (s.status == "verified") { "good" } else { if (s.status == "bad signature") { "bad" } else { "plain" } };
    return badge(kind, "index " + s.status);
}

Str hash_badge(Release r) {
    if (r.hash_state == "matches") { return badge("good", "hash matches"); }
    if (r.hash_state == "missing") { return badge("bad", "archive missing"); }
    return badge("bad", "hash differs");
}

Str sig_badge(Release r) {
    if (r.sig_state == "verified") { return badge("good", "signature verified"); }
    if (r.sig_state == "invalid") { return badge("bad", "signature invalid"); }
    if (r.sig_state == "signed") { return badge("plain", "signed (no key to check)"); }
    return badge("plain", "unsigned");
}

Str grant_badges(Manifest m) {
    if (!m.ok) { return badge("bad", "manifest unreadable"); }
    if (!m.has_grant) { return badge("plain", "no grant declared"); }
    return cap_badges(m.grant);
}

Str css() {
    return ":root{--bg:#fbfaf7;--fg:#1d1d1b;--muted:#6b6a65;--line:#e4e1d8;--card:#fff;--accent:#2f5d50;--good:#2f6b3a;--bad:#a3272b;--warn:#8a5a00;--code:#f3f1ea;--add:#e6f4e8;--del:#fbe9e9}"
        + "@media (prefers-color-scheme:dark){:root{--bg:#161614;--fg:#ecebe6;--muted:#9b9a93;--line:#2c2b27;--card:#1e1e1b;--accent:#8cc4b2;--good:#7cc48a;--bad:#ef8a8d;--warn:#e2b45c;--code:#232320;--add:#1d3323;--del:#3a1f20}}"
        + "*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.55 system-ui,sans-serif}"
        + "header{display:flex;gap:12px;align-items:center;padding:14px 20px;border-bottom:1px solid var(--line)}header a{color:inherit;text-decoration:none;font-weight:600}"
        + "main{max-width:1040px;margin:0 auto;padding:20px 16px}h1{font-size:24px;margin:0 0 6px}h2{font-size:17px;margin:20px 0 8px}h3{font-size:15px;margin:16px 0 6px}"
        + ".grow{flex:1}.muted{color:var(--muted)}.badge{display:inline-block;font-size:12px;padding:1px 8px;border-radius:999px;border:1px solid var(--line);white-space:nowrap;margin:2px 0}"
        + ".good{color:var(--good);border-color:currentColor}.bad{color:var(--bad);border-color:currentColor}.warn{color:var(--warn);border-color:currentColor}.plain{color:var(--muted)}"
        + "input[type=search],select{padding:8px 10px;font:inherit;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--fg)}input[type=search]{width:100%}"
        + "ul.list{list-style:none;padding:0;margin:12px 0}ul.list li{display:flex;flex-wrap:wrap;gap:8px 10px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-radius:8px;margin-bottom:8px;background:var(--card)}"
        + "ul.list li .desc{flex-basis:100%;margin:0}a{color:var(--accent)}code,pre{font:13px/1.45 ui-monospace,monospace}pre{background:var(--code);padding:12px;border-radius:8px;overflow:auto;max-height:560px}"
        + "table{border-collapse:collapse;width:100%}td,th{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}th{font-weight:600;color:var(--muted);font-size:13px}"
        + "button.link{background:none;border:0;padding:0;font:inherit;color:var(--accent);cursor:pointer;text-decoration:underline;text-align:left}"
        + ".bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:14px 0;border-bottom:1px solid var(--line);padding-bottom:10px}"
        + "nav.tabs{display:flex;gap:4px;flex-wrap:wrap}nav.tabs button{font:inherit;border:1px solid transparent;background:none;color:var(--fg);padding:6px 12px;border-radius:8px;cursor:pointer}"
        + "nav.tabs button.active{border-color:var(--line);background:var(--card);font-weight:600}"
        + ".hash{word-break:break-all}.cols{display:grid;grid-template-columns:minmax(0,280px) minmax(0,1fr);gap:16px}@media (max-width:760px){.cols{grid-template-columns:1fr}}"
        + ".live{font-size:13px}.on{color:var(--good)}.off{color:var(--muted)}"
        + ".md{max-width:820px}.md img{max-width:100%}.md table{width:auto}.md blockquote{margin:0;padding-left:12px;border-left:3px solid var(--line);color:var(--muted)}"
        + "table.diff td{padding:0 8px;border:0;font:12.5px/1.5 ui-monospace,monospace;white-space:pre-wrap;word-break:break-all}table.diff td.n{color:var(--muted);text-align:right;width:1%;white-space:nowrap;user-select:none}"
        + "tr.add td{background:var(--add)}tr.del td{background:var(--del)}tr.gap td{color:var(--muted);text-align:center}"
        + "details{border:1px solid var(--line);border-radius:8px;margin:8px 0;background:var(--card)}summary{padding:8px 12px;cursor:pointer}details>div{padding:0 0 8px}"
        + "ul.tree{list-style:none;padding-left:18px;margin:4px 0}ul.tree li{margin:2px 0}.snippet{position:relative}";
}

// The page around `body`. The live stream runs from its own element, so
// fetches the page makes do not cancel it; its indicator comes first, as
// Datastar applies attributes in order.
Str page(Opts o, Str title, Str signals, Str live_url, Str body) {
    Str client = if (o.cdn) { ds_cdn_script_tag() } else { ds_script_tag() };
    return "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
        + "<title>" + esc(title) + "</title><style>" + css() + "</style>" + client + "</head>"
        + "<body data-signals=\"" + attr(signals) + "\">"
        + "<header><a href=\"/\">resid registry</a><span class=\"grow\"></span>"
        + "<span class=\"live\" data-indicator:live data-init=\"" + attr(get(live_url)) + "\">"
        + "<span class=\"on\" data-show=\"$live\">&#9679; live</span><span class=\"off\" data-show=\"!$live\">&#9675; offline</span></span></header>"
        + "<main>" + body + "</main><div id=\"pulse\" hidden></div><div id=\"urlsync\" hidden></div></body></html>";
}

// Pages carry a policy that allows only this server's scripts (Datastar
// evaluates its expressions, hence 'unsafe-eval'), or the pinned CDN copy.
HttpReply html(Opts o, Int status, Str body) {
    Str cdn = if (o.cdn) { " https://cdn.jsdelivr.net" } else { "" };
    Str csp = "default-src 'self'; script-src 'self' 'unsafe-eval'" + cdn + "; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'";
    HttpReply r = http_reply_text(status, "text/html; charset=utf-8", body);
    return http_with_header(http_with_header(http_with_header(http_with_header(r, "Cache-Control", "no-cache"), "Content-Security-Policy", csp), "X-Content-Type-Options", "nosniff"), "Referrer-Policy", "no-referrer");
}

// ─── Home ───────────────────────────────────────────────────────────────

// A package row with what its newest version's manifest says.
type Row = { Package p; Manifest m; };

@requires(filesystem(readonly))
List(Row) rows_of(Str root, List(Package) ps, Int i, ListBuf(Row) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    List(Int) arch = read_arch(root, ps[i].name, ps[i].latest);
    return rows_of(root, ps, i + 1, acc.push(Row { .p = ps[i], .m = manifest_in(arch, arch_files(arch)) }));
}

// Search matches the name, the description and the keywords.
List(Row) matching_rows(List(Row) rs, Str q, Int i, ListBuf(Row) acc) {
    if (i >= rs.len()) { return acc.finish(); }
    Str hay = str_to_lower(rs[i].p.name + " " + mf_field(rs[i].m, "description") + " " + mf_field(rs[i].m, "keywords"));
    Bool hit = q == "" || str_contains(hay, q);
    return matching_rows(rs, q, i + 1, if (hit) { acc.push(rs[i]) } else { acc });
}

Str package_list(List(Row) rs, Str q) {
    if (rs.len() == 0) {
        Str msg = if (q == "") { "Nothing is published yet." } else { "No package matches “" + esc(q) + "”." };
        return "<div id=\"packages\"><p class=\"muted\">" + msg + "</p></div>";
    }
    return "<div id=\"packages\"><ul class=\"list\">" + package_rows(rs, 0, StrBuf()) + "</ul></div>";
}

Str package_rows(List(Row) rs, Int i, StrBuf b) {
    if (i >= rs.len()) { return b.finish(); }
    Package p = rs[i].p;
    Manifest m = rs[i].m;
    Str n = if (p.versions == 1) { "1 version" } else { f"{p.versions} versions" };
    Str un = if (p.indexed) { "" } else { " " + badge("plain", "not in index") };
    Str lic = mf_field(m, "license");
    Str licb = if (lic == "") { "" } else { badge("plain", lic) + " " };
    Str desc = mf_field(m, "description");
    Str d = if (desc == "") { "" } else { "<p class=\"desc muted\">" + esc(desc) + "</p>" };
    Str row = "<li><a href=\"/pkg/" + pct(p.name) + "\"><strong>" + esc(p.name) + "</strong></a><code>" + esc(p.latest) + "</code>"
        + "<span class=\"grow\"></span>" + licb + grant_badges(m) + un + " <span class=\"muted\">" + n + "</span>" + d + "</li>";
    return package_rows(rs, i + 1, b.push(row));
}

@requires(filesystem(readonly))
Str home_list(Str root, Registry reg, Str q) {
    List(Package) all = packages(reg.entries, 0, ListBuf());
    List(Row) rs = rows_of(root, all, 0, ListBuf());
    return package_list(matching_rows(rs, str_to_lower(str_trim(q)), 0, ListBuf()), q);
}

@requires(filesystem(readonly))
Str home_body(Str root, Registry reg) {
    List(Package) all = packages(reg.entries, 0, ListBuf());
    Str count = f"{all.len()} package(s), {reg.entries.len()} archive(s)";
    return "<h1>Packages</h1><p class=\"muted\">" + count + " &middot; " + index_badge(reg.index) + "</p>"
        + "<input type=\"search\" placeholder=\"Search names, descriptions, keywords\" aria-label=\"Search packages\" data-bind:q data-on:input__debounce.200ms=\"" + attr(get("/ui/search")) + "\">"
        + home_list(root, reg, "");
}

// ─── A package ──────────────────────────────────────────────────────────

// What the package page is showing.
type View = { Str name; Str ver; Str tab; Str file; Str from; Str to; };

List(Str) tabs() { return ["readme", "manifest", "files", "deps", "diff"]; }

Str tab_label(Str t) {
    if (t == "readme") { return "Readme"; }
    if (t == "manifest") { return "Manifest"; }
    if (t == "files") { return "Files"; }
    if (t == "deps") { return "Dependencies"; }
    return "Diff";
}

Str view_url(View v) {
    Str file = if (v.tab == "files" && v.file != "") { "&file=" + pct(v.file) } else { "" };
    Str cmp = if (v.tab == "diff" && v.from != "") { "&from=" + pct(v.from) } else { "" };
    return "/pkg/" + pct(v.name) + "?v=" + pct(v.ver) + "&tab=" + v.tab + file + cmp;
}

// The view a request names; unknown or missing parts fall back to the
// newest version, its readme, and the version before it.
View view_of(Str name, List(Entry) vs, Str ver0, Str tab0, Str file, Str from0) {
    Str ver = if (has_version(vs, ver0, 0)) { ver0 } else { vs[0].version };
    Str tab = if (tabs().contains(tab0)) { tab0 } else { "readme" };
    Str prev = previous_version(vs, ver, 0);
    Str from = if (has_version(vs, from0, 0)) { from0 } else { if (prev == "") { ver } else { prev } };
    return View { .name = name, .ver = ver, .tab = tab, .file = file, .from = from, .to = ver };
}

Bool has_version(List(Entry) vs, Str v, Int i) {
    if (i >= vs.len()) { return false; }
    if (vs[i].version == v) { return true; }
    return has_version(vs, v, i + 1);
}

Str summary(Opts o, Release r, List(Entry) vs) {
    Manifest m = r.m;
    Str desc = mf_field(m, "description");
    Str d = if (desc == "") { "" } else { "<p>" + esc(desc) + "</p>" };
    Str lic = mf_field(m, "license");
    Str licb = if (lic == "") { "" } else { badge("plain", lic) + " " };
    Str latest = if (vs[0].version == r.entry.version) { badge("good", "latest") + " " } else { badge("warn", "newer: " + vs[0].version) + " " };
    Str listed = if (r.entry.indexed) { "" } else { " " + badge("plain", "not in index") };
    Str dl = "/download/" + pct(r.entry.name) + "/" + pct(r.entry.version);
    return "<div id=\"summary\">" + d + "<p>" + latest + licb + hash_badge(r) + " " + sig_badge(r) + listed + "</p>"
        + "<p>" + grant_badges(m) + "</p>"
        + "<p class=\"muted\"><a href=\"" + dl + "\">download</a> &middot; " + size_text(r.arch.len()) + f" &middot; {r.files.len()} files</p></div>";
}

Str bar(View v, List(Entry) vs) {
    Str change = "$file = ''; $from = ''; " + get("/ui/view/" + pct(v.name));
    return "<div id=\"bar\" class=\"bar\"><label>Version <select data-bind:ver data-on:change=\"" + attr(change) + "\">" + version_options(vs, v.ver, 0, StrBuf()) + "</select></label>"
        + "<nav class=\"tabs\">" + tab_buttons(v, tabs(), 0, StrBuf()) + "</nav></div>";
}

Str version_options(List(Entry) vs, Str sel, Int i, StrBuf b) {
    if (i >= vs.len()) { return b.finish(); }
    Str s = if (vs[i].version == sel) { " selected" } else { "" };
    Str tag = if (i == 0) { " (latest)" } else { "" };
    return version_options(vs, sel, i + 1, b.push("<option value=\"" + attr(vs[i].version) + "\"" + s + ">" + esc(vs[i].version + tag) + "</option>"));
}

Str tab_buttons(View v, List(Str) ts, Int i, StrBuf b) {
    if (i >= ts.len()) { return b.finish(); }
    Str t = ts[i];
    Str active = if (t == v.tab) { " class=\"active\"" } else { "" };
    Str click = "$tab = '" + t + "'; " + get("/ui/view/" + pct(v.name));
    return tab_buttons(v, ts, i + 1, b.push("<button" + active + " data-class:active=\"$tab == '" + t + "'\" data-on:click=\"" + attr(click) + "\">" + tab_label(t) + "</button>"));
}

// ─── Panels ─────────────────────────────────────────────────────────────

// Relative links in a README open that file in the Files tab.
Str file_base(Release r) { return "/pkg/" + pct(r.entry.name) + "?v=" + pct(r.entry.version) + "&tab=files&file="; }

Str readme_panel(Release r) {
    Option(ArchFile) f = arch_find(r.files, r.readme, 0);
    return match f {
        Some(x) => "<div class=\"md\">" + if (str_ends_with(str_to_upper(x.path), ".TXT") || !str_contains(x.path, ".")) { "<pre>" + esc(file_text(r.arch, x)) + "</pre>" } else { md_html(file_text(r.arch, x), file_base(r)) } + "</div>",
        None => "<p class=\"muted\">This version has no README. Its manifest and files are in the other tabs.</p>"
    };
}

Str manifest_panel(Opts o, Release r) {
    Manifest m = r.m;
    if (!m.ok) { return "<p>" + badge("bad", "manifest") + " " + esc(m.error) + "</p>" + raw_manifest(r); }
    Str fields = field_rows(m.fields, 0, StrBuf());
    Str grant = if (!m.has_grant) { "<p class=\"muted\">No <code>[capabilities] grant</code>: the package declares no authority, so it may use none.</p>" }
        else { "<p>" + cap_badges(m.grant) + "</p><p class=\"muted\">The most this package's code may do. Marked grants can change the system or reach outside it; the rest only read.</p>" };
    Str signing = if (m.require_signatures) { "<p>" + badge("good", "require_signatures") + " its own dependencies must carry signatures.</p>" } else { "" };
    Str snippet = dep_snippet(r.entry.name, r.entry.version, o.pubkey);
    Str copy = "navigator.clipboard.writeText(el.dataset.text)";
    return "<h2>Package</h2><table>" + fields + "</table>"
        + "<h2>Capabilities</h2>" + grant + signing
        + "<h2>Use it</h2><div class=\"snippet\"><pre>" + esc(snippet) + "</pre><button class=\"link\" data-text=\"" + attr(snippet) + "\" data-on:click=\"" + attr(copy) + "\">copy</button></div>"
        + "<h2><code>resid.toml</code></h2>" + raw_manifest(r);
}

Str raw_manifest(Release r) {
    Option(ArchFile) f = arch_find(r.files, "resid.toml", 0);
    return match f { Some(x) => "<pre>" + esc(file_text(r.arch, x)) + "</pre>", None => "<p class=\"muted\">No resid.toml.</p>" };
}

Str field_rows(List(MField) fs, Int i, StrBuf b) {
    if (i >= fs.len()) { return b.finish(); }
    Str v = fs[i].value;
    Bool link = str_starts_with(v, "https://") || str_starts_with(v, "http://");
    Str shown = if (link) { "<a href=\"" + attr(v) + "\" rel=\"nofollow noopener\">" + esc(v) + "</a>" } else { esc(v) };
    return field_rows(fs, i + 1, b.push("<tr><th>" + esc(fs[i].key) + "</th><td>" + shown + "</td></tr>"));
}

Str files_panel(Release r, Str file) {
    Str open = if (file != "" && has_file(r.files, file, 0)) { file } else { if (r.readme != "") { r.readme } else { "resid.toml" } };
    return "<div class=\"cols\"><ul class=\"list\">" + file_rows(r, 0, StrBuf()) + "</ul>" + file_view(r, open) + "</div>";
}

Str file_rows(Release r, Int i, StrBuf b) {
    if (i >= r.files.len()) { return b.finish(); }
    ArchFile f = r.files[i];
    Str url = "/ui/file/" + pct(r.entry.name) + "/" + pct(r.entry.version) + "/" + pct(f.path);
    Str click = "$file = " + ds_json_str(f.path) + "; " + get(url);
    Str row = "<li><button class=\"link\" data-on:click=\"" + attr(click) + "\">" + esc(f.path) + "</button><span class=\"grow\"></span><span class=\"muted\">" + size_text(f.size) + "</span></li>";
    return file_rows(r, i + 1, b.push(row));
}

Str file_view(Release r, Str path) {
    Option(ArchFile) f = arch_find(r.files, path, 0);
    Str raw = "/raw/" + pct(r.entry.name) + "/" + pct(r.entry.version) + "/" + pct(path);
    return match f {
        Some(x) => "<div id=\"viewer\"><h3><code>" + esc(x.path) + "</code> <a class=\"muted\" href=\"" + raw + "\">raw</a></h3>"
            + if (is_text(r.arch, x)) { "<pre>" + esc(file_text(r.arch, x)) + "</pre>" } else { "<p class=\"muted\">Not shown: " + size_text(x.size) + " of binary or large content.</p>" }
            + "</div>",
        None => "<div id=\"viewer\"><p class=\"muted\">No such file.</p></div>"
    };
}

// ─── Dependencies ───────────────────────────────────────────────────────

// Where a dependency resolves in this registry: the entry, or why not.
type Resolved = { Bool found; Entry entry; Str note; };

Resolved resolve(List(Entry) es, Dep d) {
    List(Entry) vs = versions_of(es, d.name, 0, ListBuf());
    Entry none = Entry { .name = "", .version = "", .recorded = "", .indexed = false };
    if (d.version != "") {
        Option(Entry) e = entry_of(es, d.name, d.version, 0);
        return match e {
            Some(x) => Resolved { .found = true, .entry = x, .note = "" },
            None => Resolved { .found = false, .entry = none, .note = if (vs.len() == 0) { "not in this registry" } else { "version not published here (newest " + vs[0].version + ")" } }
        };
    }
    if (vs.len() > 0) { return Resolved { .found = true, .entry = vs[0], .note = "path dependency; shown as the registry's newest" }; }
    return Resolved { .found = false, .entry = none, .note = "path dependency, not in this registry" };
}

Str requirement(Dep d) {
    if (d.version != "") { return "version " + d.version; }
    if (d.path != "") { return "path " + d.path; }
    return "unspecified";
}

Str dep_rows(List(Entry) es, List(Dep) ds, Int i, StrBuf b) {
    if (i >= ds.len()) { return b.finish(); }
    Dep d = ds[i];
    Resolved r = resolve(es, d);
    Str name = if (r.found) { "<a href=\"/pkg/" + pct(d.name) + "?v=" + pct(r.entry.version) + "\">" + esc(d.name) + "</a>" } else { esc(d.name) };
    Str status = if (r.found && r.note == "") { badge("good", "in registry") } else { if (r.found) { badge("plain", r.note) } else { badge("bad", r.note) } };
    Str ceiling = if (d.has_caps) { cap_badges(d.caps) } else { "<span class=\"muted\">the package's grant</span>" };
    Str key = if (d.pubkey == "") { "<span class=\"muted\">none</span>" } else { "<code title=\"" + attr(d.pubkey) + "\">" + esc(str_slice(d.pubkey, 0, if (str_len(d.pubkey) > 12) { 12 } else { str_len(d.pubkey) })) + "&hellip;</code>" };
    return dep_rows(es, ds, i + 1, b.push("<tr><td>" + name + "</td><td>" + esc(requirement(d)) + "</td><td>" + ceiling + "</td><td>" + key + "</td><td>" + status + "</td></tr>"));
}

// The tree below a release, each package once per path; a cycle or the
// depth limit stops a branch and says so.
Str dep_tree(List(Lite) all, List(Entry) es, Manifest m, List(Str) path, Int depth) {
    if (m.deps.len() == 0) { return ""; }
    return "<ul class=\"tree\">" + tree_items(all, es, m.deps, 0, path, depth, StrBuf()) + "</ul>";
}

Str tree_items(List(Lite) all, List(Entry) es, List(Dep) ds, Int i, List(Str) path, Int depth, StrBuf b) {
    if (i >= ds.len()) { return b.finish(); }
    Dep d = ds[i];
    Resolved r = resolve(es, d);
    Str key = d.name + "@" + r.entry.version;
    Str label = esc(d.name) + " <span class=\"muted\">" + esc(requirement(d)) + "</span>";
    Str item = if (!r.found) { label + " " + badge("bad", r.note) }
        else { if (path.contains(key)) { label + " " + badge("bad", "cycle") }
        else { if (depth >= 12) { label + " " + badge("plain", "deeper than shown") }
        else { "<a href=\"/pkg/" + pct(d.name) + "?v=" + pct(r.entry.version) + "&tab=deps\">" + esc(d.name) + "</a> <code>" + esc(r.entry.version) + "</code>" + (if (r.note == "") { "" } else { " " + badge("plain", r.note) }) + dep_tree(all, es, lite_manifest(all, r.entry, 0), path.concat([key]), depth + 1) } } };
    return tree_items(all, es, ds, i + 1, path, depth, b.push("<li>" + item + "</li>"));
}

Manifest lite_manifest(List(Lite) all, Entry e, Int i) {
    if (i >= all.len()) { return manifest_none("not loaded"); }
    if (all[i].entry.name == e.name && all[i].entry.version == e.version) { return all[i].m; }
    return lite_manifest(all, e, i + 1);
}

// Every release that depends on `name`, and whether it asks for `version`.
Str used_by(List(Lite) all, Str name, Str version, Int i, StrBuf b) {
    if (i >= all.len()) { return b.finish(); }
    Option(Dep) d = dep_named(all[i].m.deps, name, 0);
    Str row = match d {
        Some(x) => "<tr><td><a href=\"/pkg/" + pct(all[i].entry.name) + "?v=" + pct(all[i].entry.version) + "&tab=deps\">" + esc(all[i].entry.name) + "</a></td><td><code>" + esc(all[i].entry.version) + "</code></td><td>" + esc(requirement(x)) + "</td><td>"
            + (if (x.version == version) { badge("good", "this version") } else { if (x.version == "") { badge("plain", "path") } else { badge("plain", "another version") } }) + "</td></tr>",
        None => ""
    };
    return used_by(all, name, version, i + 1, b.push(row));
}

Option(Dep) dep_named(List(Dep) ds, Str name, Int i) {
    if (i >= ds.len()) { return None; }
    if (ds[i].name == name) { return Some(ds[i]); }
    return dep_named(ds, name, i + 1);
}

@requires(filesystem(readonly))
Str deps_panel(Str root, Registry reg, Release r) {
    List(Dep) ds = r.m.deps;
    List(Lite) all = all_manifests(root, reg.entries, 0, ListBuf());
    Str direct = if (ds.len() == 0) { "<p class=\"muted\">No dependencies.</p>" }
        else { "<table><tr><th>Package</th><th>Requires</th><th>Ceiling</th><th>Pinned key</th><th></th></tr>" + dep_rows(reg.entries, ds, 0, StrBuf()) + "</table>" };
    Str tree = if (ds.len() == 0) { "" } else { "<h2>All of them</h2>" + dep_tree(all, reg.entries, r.m, [r.entry.name + "@" + r.entry.version], 0) };
    Str users = used_by(all, r.entry.name, r.entry.version, 0, StrBuf());
    Str ub = if (users == "") { "<p class=\"muted\">Nothing in this registry depends on " + esc(r.entry.name) + ".</p>" }
        else { "<table><tr><th>Package</th><th>Version</th><th>Requires</th><th></th></tr>" + users + "</table>" };
    return "<h2>Direct</h2>" + direct + tree + "<h2>Used by</h2>" + ub;
}

// ─── Diff ───────────────────────────────────────────────────────────────

Str diff_selects(View v, List(Entry) vs) {
    Str go = get("/ui/view/" + pct(v.name));
    return "<p class=\"bar\"><label>From <select data-bind:from data-on:change=\"" + attr(go) + "\">" + version_options(vs, v.from, 0, StrBuf()) + "</select></label>"
        + "<label>to <b>" + esc(v.to) + "</b> <span class=\"muted\">(the version above)</span></label></p>";
}

Str diff_panel(View v, List(Entry) vs, Release a, Release b) {
    Str head = diff_selects(v, vs);
    if (a.entry.version == b.entry.version) { return head + "<p class=\"muted\">Pick an earlier version to compare with.</p>"; }
    List(Str) pa = paths(a.files, 0, ListBuf());
    List(Str) pb = paths(b.files, 0, ListBuf());
    List(Str) added = minus(pb, pa, 0, ListBuf());
    List(Str) removed = minus(pa, pb, 0, ListBuf());
    List(Str) common = minus(pb, added, 0, ListBuf());
    List(Str) changed = changed_files(a, b, common, 0, ListBuf());
    Str counts = f"<p>{added.len()} added, {removed.len()} removed, {changed.len()} changed, {common.len() - changed.len()} unchanged</p>";
    return head + counts + manifest_changes(a.m, b.m)
        + name_list("Added", added) + name_list("Removed", removed)
        + "<h2>Changes</h2>" + (if (changed.len() == 0) { "<p class=\"muted\">No file changed.</p>" } else { file_diffs(a, b, changed, 0, StrBuf()) });
}

List(Str) paths(List(ArchFile) fs, Int i, ListBuf(Str) acc) {
    if (i >= fs.len()) { return acc.finish(); }
    return paths(fs, i + 1, acc.push(fs[i].path));
}

List(Str) minus(List(Str) xs, List(Str) ys, Int i, ListBuf(Str) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    return minus(xs, ys, i + 1, if (ys.contains(xs[i])) { acc } else { acc.push(xs[i]) });
}

List(Str) changed_files(Release a, Release b, List(Str) ps, Int i, ListBuf(Str) acc) {
    if (i >= ps.len()) { return acc.finish(); }
    Option(ArchFile) fa = arch_find(a.files, ps[i], 0);
    Option(ArchFile) fb = arch_find(b.files, ps[i], 0);
    Bool same = match fa { Some(x) => match fb { Some(y) => x.size == y.size && same_bytes(a.arch, x.at, b.arch, y.at, x.size), None => false }, None => false };
    return changed_files(a, b, ps, i + 1, if (same) { acc } else { acc.push(ps[i]) });
}

Bool same_bytes(List(Int) a, Int i, List(Int) b, Int j, Int n) {
    if (n <= 0) { return true; }
    if (a[i] != b[j]) { return false; }
    return same_bytes(a, i + 1, b, j + 1, n - 1);
}

Str name_list(Str title, List(Str) xs) {
    if (xs.len() == 0) { return ""; }
    return "<h3>" + title + "</h3><p>" + code_list(xs, 0, StrBuf()) + "</p>";
}

Str code_list(List(Str) xs, Int i, StrBuf b) {
    if (i >= xs.len()) { return b.finish(); }
    return code_list(xs, i + 1, b.push(if (i == 0) { "" } else { " " }).push("<code>" + esc(xs[i]) + "</code>"));
}

// What the manifests say differently: the grant first, as it is what a
// reviewer most needs to see, then dependencies.
Str manifest_changes(Manifest a, Manifest b) {
    List(Str) gained = minus(b.grant, a.grant, 0, ListBuf());
    List(Str) lost = minus(a.grant, b.grant, 0, ListBuf());
    List(Str) da = dep_keys(a.deps, 0, ListBuf());
    List(Str) db = dep_keys(b.deps, 0, ListBuf());
    List(Str) dadd = minus(db, da, 0, ListBuf());
    List(Str) drem = minus(da, db, 0, ListBuf());
    Str g = if (gained.len() == 0 && lost.len() == 0) { "<p class=\"muted\">Capabilities unchanged.</p>" }
        else { "<p>" + (if (gained.len() > 0) { "<b>Gains</b> " + cap_badges(gained) + " " } else { "" }) + (if (lost.len() > 0) { "<b>Drops</b> " + code_list(lost, 0, StrBuf()) } else { "" }) + "</p>" };
    Str d = if (dadd.len() == 0 && drem.len() == 0) { "<p class=\"muted\">Dependencies unchanged.</p>" }
        else { "<p>" + (if (dadd.len() > 0) { "<b>New dependencies</b> " + code_list(dadd, 0, StrBuf()) + " " } else { "" }) + (if (drem.len() > 0) { "<b>No longer</b> " + code_list(drem, 0, StrBuf()) } else { "" }) + "</p>" };
    return "<h2>Manifest</h2>" + g + d;
}

// A dependency as "name requirement [ceiling]", so any change shows.
List(Str) dep_keys(List(Dep) ds, Int i, ListBuf(Str) acc) {
    if (i >= ds.len()) { return acc.finish(); }
    Str caps = if (ds[i].has_caps) { " [" + str_join(ds[i].caps, ", ") + "]" } else { "" };
    return dep_keys(ds, i + 1, acc.push(ds[i].name + " " + requirement(ds[i]) + caps));
}

Str file_diffs(Release a, Release b, List(Str) ps, Int i, StrBuf out) {
    if (i >= ps.len()) { return out.finish(); }
    if (i >= 60) { return out.push(f"<p class=\"muted\">{ps.len() - 60} more files not shown.</p>").finish(); }
    Option(ArchFile) fa = arch_find(a.files, ps[i], 0);
    Option(ArchFile) fb = arch_find(b.files, ps[i], 0);
    Str body = match fa { Some(x) => match fb { Some(y) => one_diff(a, x, b, y), None => "" }, None => "" };
    return file_diffs(a, b, ps, i + 1, out.push(body));
}

Str one_diff(Release a, ArchFile x, Release b, ArchFile y) {
    if (!is_text(a.arch, x) || !is_text(b.arch, y)) {
        return "<details><summary><code>" + esc(x.path) + "</code> <span class=\"muted\">binary or large: " + size_text(x.size) + " to " + size_text(y.size) + "</span></summary></details>";
    }
    Diff d = diff_texts(file_text(a.arch, x), file_text(b.arch, y), 3000);
    if (!d.ok) {
        return "<details><summary><code>" + esc(x.path) + "</code> <span class=\"muted\">too different to show line by line</span></summary></details>";
    }
    List(Hunk) hs = diff_hunks(d.ops, 3);
    return "<details open><summary><code>" + esc(x.path) + "</code> " + badge("good", f"+{d.added}") + " " + badge("bad", f"-{d.removed}") + "</summary><div><table class=\"diff\">"
        + hunk_rows(d.ops, hs, 0, 0, StrBuf()) + "</table></div></details>";
}

// The hunks' lines, at most 4000 in all, a gap row between hunks.
Str hunk_rows(List(DiffOp) ops, List(Hunk) hs, Int h, Int shown, StrBuf b) {
    if (h >= hs.len()) { return b.finish(); }
    if (shown >= 4000) { return b.push("<tr class=\"gap\"><td colspan=\"3\">diff cut short</td></tr>").finish(); }
    StrBuf gap = if (h > 0) { b.push("<tr class=\"gap\"><td colspan=\"3\">&middot;&middot;&middot;</td></tr>") } else { b };
    StrBuf lines = op_rows(ops, hs[h].from, hs[h].to, gap);
    return hunk_rows(ops, hs, h + 1, shown + hs[h].to - hs[h].from, lines);
}

StrBuf op_rows(List(DiffOp) ops, Int i, Int end, StrBuf b) {
    if (i >= end) { return b; }
    DiffOp o = ops[i];
    Str cls = if (o.kind == 1) { " class=\"del\"" } else { if (o.kind == 2) { " class=\"add\"" } else { "" } };
    Str mark = if (o.kind == 1) { "-" } else { if (o.kind == 2) { "+" } else { " " } };
    Str na = if (o.a > 0) { f"{o.a}" } else { "" };
    Str nb = if (o.b > 0) { f"{o.b}" } else { "" };
    return op_rows(ops, i + 1, end, b.push("<tr" + cls + "><td class=\"n\">" + na + "</td><td class=\"n\">" + nb + "</td><td>" + mark + " " + esc(o.line) + "</td></tr>"));
}

// ─── The package page ───────────────────────────────────────────────────

@requires(filesystem(readonly))
Str panel(Opts o, Registry reg, View v, List(Entry) vs, Release r) {
    if (v.tab == "manifest") { return manifest_panel(o, r); }
    if (v.tab == "files") { return files_panel(r, v.file); }
    if (v.tab == "deps") { return deps_panel(o.root, reg, r); }
    if (v.tab == "diff") {
        Entry fe = entry_of(vs, v.name, v.from, 0) else { r.entry };
        Release a = if (fe.version == r.entry.version) { r } else { release(o.root, o.pubkey, fe) };
        return diff_panel(v, vs, a, r);
    }
    return readme_panel(r);
}

Str title(View v) { return "<h1 id=\"title\">" + esc(v.name) + " <code>" + esc(v.ver) + "</code></h1>"; }

Str signals_of(View v) {
    return "{ver: " + ds_json_str(v.ver) + ", tab: " + ds_json_str(v.tab) + ", file: " + ds_json_str(v.file) + ", from: " + ds_json_str(v.from) + "}";
}

@requires(filesystem(readonly))
Str package_page(Opts o, Registry reg, View v, List(Entry) vs) {
    Entry e = entry_of(vs, v.name, v.ver, 0) else { vs[0] };
    Release r = release(o.root, o.pubkey, e);
    Str body = title(v) + "<p class=\"muted\">" + index_badge(reg.index) + "</p>"
        + summary(o, r, vs) + bar(v, vs) + "<div id=\"panel\">" + panel(o, reg, v, vs, r) + "</div>";
    return page(o, v.name + " " + v.ver + " - resid registry", signals_of(v), "/ui/live/pkg/" + pct(v.name), body);
}

// The events that bring a page to `v`: its parts, its signals, its URL.
@requires(filesystem(readonly))
List(Str) view_events(Opts o, Registry reg, View v, List(Entry) vs) {
    Entry e = entry_of(vs, v.name, v.ver, 0) else { vs[0] };
    Release r = release(o.root, o.pubkey, e);
    return [
        ds_patch_elements(title(v)),
        ds_patch_signals("{\"ver\":" + ds_json_str(v.ver) + ",\"tab\":" + ds_json_str(v.tab) + ",\"from\":" + ds_json_str(v.from) + "}"),
        ds_patch_elements(summary(o, r, vs)),
        ds_patch_elements(bar(v, vs)),
        ds_patch_elements("<div id=\"panel\">" + panel(o, reg, v, vs, r) + "</div>"),
        url_sync(view_url(v))
    ];
}

// Keep the address bar on the view. The page's policy runs no inline
// script, so this is an element whose data-init Datastar evaluates.
Str url_sync(Str url) {
    Str js = "window.history.replaceState({}, '', " + ds_json_str(url) + ")";
    return ds_patch_elements("<div data-init=\"" + attr(js) + "\"></div>", selector = "#urlsync", mode = ModeInner);
}

// ─── Handlers ───────────────────────────────────────────────────────────

HttpReply not_found(Opts o) {
    return html(o, 404, page(o, "Not found", "{}", "/ui/live/home", "<h1>Not found</h1><p><a href=\"/\">All packages</a></p>"));
}

Str cap(Map(Str, Str) m, Str k) { return m.get(k) else { "" }; }

Str qp(HttpRequest r, Str k) { return http_query_param(r.query, k); }

Value signals(HttpRequest r) {
    Result(Value, Str) s = ds_read_signals_value(r);
    return s else { VUnit };
}

// The live stream: poll the registry's fingerprint every `poll_ms`; when
// it moves, drop an element into #pulse whose data-init fetches `refresh`
// with the page's current signals. A comment every 15 s keeps it open.
type Live = { Str root; Str fp; Str refresh; Int poll_ms; Int idle; };

@requires(filesystem(readonly))
HttpStep(Live) live_step(Live s) {
    Str now = fingerprint(s.root);
    Int quiet = 15000 / s.poll_ms;
    if (now != s.fp) {
        Str pulse = "<div id=\"pulse-" + str_slice(now, 0, 12) + "\" data-init=\"" + attr(get(s.refresh)) + "\"></div>";
        Live next = Live { .root = s.root, .fp = now, .refresh = s.refresh, .poll_ms = s.poll_ms, .idle = 0 };
        return ds_step(next, [ds_patch_elements(pulse, selector = "#pulse", mode = ModeInner)], s.poll_ms);
    }
    Bool ping = s.idle + 1 >= quiet;
    Live later = Live { .root = s.root, .fp = s.fp, .refresh = s.refresh, .poll_ms = s.poll_ms, .idle = if (ping) { 0 } else { s.idle + 1 } };
    List(Str) out = if (ping) { [ds_keepalive()] } else { [] };
    return ds_step(later, out, s.poll_ms);
}

@requires(filesystem(readonly))
HttpOut(Live) live(Opts o, Str refresh) {
    Live s = Live { .root = o.root, .fp = fingerprint(o.root), .refresh = refresh, .poll_ms = o.poll_ms, .idle = 0 };
    return ds_stream(s, [], o.poll_ms, lambda(x) { live_step(x) });
}

List(Str) decoded(List(Str) xs, Int i, ListBuf(Str) acc) {
    if (i >= xs.len()) { return acc.finish(); }
    return decoded(xs, i + 1, acc.push(http_url_decode(xs[i], false)));
}

Str decode_path(Str p) { return str_join(decoded(str_split(p, "/"), 0, ListBuf()), "/"); }

@requires(filesystem(readonly))
HttpOut(Live) route(Opts o, HttpRequest r) {
    if (r.method != "GET" && r.method != "HEAD") { return Whole(http_with_header(http_reply_status(405), "Allow", "GET, HEAD")); }
    if (r.path == ds_client_path()) { return Whole(ds_client_reply()); }
    if (r.path == "/") {
        Registry reg = load(o.root, o.pubkey);
        return Whole(html(o, 200, page(o, "resid registry", "{q: ''}", "/ui/live/home", home_body(o.root, reg))));
    }
    if (r.path == "/ui/live/home") { return live(o, "/ui/search"); }
    if (r.path == "/ui/search") {
        Registry reg = load(o.root, o.pubkey);
        return Whole(ds_reply([ds_patch_elements(home_list(o.root, reg, ds_signal_text(signals(r), "q")))]));
    }
    Map(Str, Str) none = {};
    Map(Str, Str) pk = http_route("/pkg/:name", r.path) else { none };
    if (pk.len() > 0 && safe_word(cap(pk, "name"))) {
        Str name = cap(pk, "name");
        Registry reg = load(o.root, o.pubkey);
        List(Entry) vs = versions_of(reg.entries, name, 0, ListBuf());
        if (vs.len() == 0) { return Whole(not_found(o)); }
        View v = view_of(name, vs, qp(r, "v"), qp(r, "tab"), qp(r, "file"), qp(r, "from"));
        return Whole(html(o, 200, package_page(o, reg, v, vs)));
    }
    Map(Str, Str) lp = http_route("/ui/live/pkg/:name", r.path) else { none };
    if (lp.len() > 0 && safe_word(cap(lp, "name"))) { return live(o, "/ui/view/" + pct(cap(lp, "name"))); }
    Map(Str, Str) vw = http_route("/ui/view/:name", r.path) else { none };
    if (vw.len() > 0 && safe_word(cap(vw, "name"))) {
        Str name = cap(vw, "name");
        Registry reg = load(o.root, o.pubkey);
        List(Entry) vs = versions_of(reg.entries, name, 0, ListBuf());
        if (vs.len() == 0) { return Whole(ds_reply([ds_patch_elements("<div id=\"panel\"><p class=\"muted\">This package is gone.</p></div>")])); }
        Value s = signals(r);
        View v = view_of(name, vs, ds_signal_text(s, "ver"), ds_signal_text(s, "tab"), ds_signal_text(s, "file"), ds_signal_text(s, "from"));
        return Whole(ds_reply(view_events(o, reg, v, vs)));
    }
    Map(Str, Str) fv = http_route("/ui/file/:name/:version/*", r.path) else { none };
    if (fv.len() > 0 && safe_word(cap(fv, "name")) && safe_word(cap(fv, "version"))) {
        Registry reg = load(o.root, o.pubkey);
        Option(Entry) e = entry_of(reg.entries, cap(fv, "name"), cap(fv, "version"), 0);
        Bool gone = match e { Some(x) => false, None => true };
        if (gone) { return Whole(ds_reply([ds_patch_elements("<div id=\"viewer\"><p class=\"muted\">That version is gone.</p></div>")])); }
        Release rel = release(o.root, o.pubkey, e else { reg.entries[0] });
        Str path = decode_path(cap(fv, "*"));
        View v = View { .name = rel.entry.name, .ver = rel.entry.version, .tab = "files", .file = path, .from = "", .to = rel.entry.version };
        return Whole(ds_reply([ds_patch_elements(file_view(rel, path)), url_sync(view_url(v))]));
    }
    Map(Str, Str) raw = http_route("/raw/:name/:version/*", r.path) else { none };
    if (raw.len() > 0 && safe_word(cap(raw, "name")) && safe_word(cap(raw, "version"))) {
        List(Int) arch = read_arch(o.root, cap(raw, "name"), cap(raw, "version"));
        Option(ArchFile) f = arch_find(arch_files(arch), decode_path(cap(raw, "*")), 0);
        return match f {
            Some(x) => Whole(http_with_header(http_with_header(http_reply_bytes(200, "text/plain; charset=utf-8", arch[x.at..(x.at + x.size)]), "X-Content-Type-Options", "nosniff"), "Content-Security-Policy", "sandbox")),
            None => Whole(not_found(o))
        };
    }
    Map(Str, Str) dl = http_route("/download/:name/:version", r.path) else { none };
    if (dl.len() > 0 && safe_word(cap(dl, "name")) && safe_word(cap(dl, "version"))) {
        List(Int) arch = read_arch(o.root, cap(dl, "name"), cap(dl, "version"));
        if (arch.len() == 0) { return Whole(not_found(o)); }
        HttpReply a = http_reply_bytes(200, "application/octet-stream", arch);
        return Whole(http_with_header(a, "Content-Disposition", "attachment; filename=\"" + cap(dl, "name") + "-" + cap(dl, "version") + ".resid-pkg\""));
    }
    return Whole(not_found(o));
}

// ─── Command line ───────────────────────────────────────────────────────

Str usage() { return "usage: resid-registry-ui <registry> [--port N] [--port-file F] [--pubkey HEX] [--cdn] [--poll-ms N] [--requests N]"; }

Opts with(Opts o, Str root, Int port, Str port_file, Str pubkey, Bool cdn, Int poll_ms, Int requests, Bool ok) {
    return Opts { .root = root, .port = port, .port_file = port_file, .pubkey = pubkey, .cdn = cdn, .poll_ms = poll_ms, .requests = requests, .ok = ok };
}

Int num(Str s) { return if (str_is_int(s)) { str_parse_int(s) } else { -1 }; }

@requires(args)
Opts parse(Int i, Opts o) {
    if (i >= args.count()) { return o; }
    Str a = args.get(i);
    Str v = if (i + 1 < args.count()) { args.get(i + 1) } else { "" };
    Bool has = i + 1 < args.count();
    if (a == "--cdn") { return parse(i + 1, with(o, o.root, o.port, o.port_file, o.pubkey, true, o.poll_ms, o.requests, o.ok)); }
    if (a == "--port" && has) { return parse(i + 2, with(o, o.root, num(v), o.port_file, o.pubkey, o.cdn, o.poll_ms, o.requests, o.ok && num(v) >= 0)); }
    if (a == "--port-file" && has) { return parse(i + 2, with(o, o.root, o.port, v, o.pubkey, o.cdn, o.poll_ms, o.requests, o.ok)); }
    if (a == "--pubkey" && has) { return parse(i + 2, with(o, o.root, o.port, o.port_file, str_trim(v), o.cdn, o.poll_ms, o.requests, o.ok && str_len(str_trim(v)) == 64)); }
    if (a == "--poll-ms" && has) { return parse(i + 2, with(o, o.root, o.port, o.port_file, o.pubkey, o.cdn, num(v), o.requests, o.ok && num(v) >= 50)); }
    if (a == "--requests" && has) { return parse(i + 2, with(o, o.root, o.port, o.port_file, o.pubkey, o.cdn, o.poll_ms, num(v), o.ok && num(v) >= 0)); }
    if (!str_starts_with(a, "--") && o.root == "") { return parse(i + 1, with(o, a, o.port, o.port_file, o.pubkey, o.cdn, o.poll_ms, o.requests, o.ok)); }
    return with(o, o.root, o.port, o.port_file, o.pubkey, o.cdn, o.poll_ms, o.requests, false);
}

@requires(args, filesystem, network(readonly))
Int main() {
    Opts start = Opts { .root = "", .port = 8090, .port_file = "", .pubkey = "", .cdn = false, .poll_ms = 1000, .requests = 0, .ok = true };
    Opts o = parse(1, start);
    if (!o.ok || o.root == "") { eprintln(usage()); return 2; }
    if (!filesystem.is_dir(o.root)) { eprintln("resid-registry-ui: not a directory: " + o.root); return 1; }
    Int lfd = http_listen(o.port);
    if (lfd < 0) { eprintln(f"resid-registry-ui: cannot listen on 127.0.0.1:{o.port}"); return 1; }
    Int port = http_bound_port(lfd);
    if (o.port_file != "") { filesystem.write_all(o.port_file, f"{port}\n"); }
    println(f"resid-registry-ui: http://127.0.0.1:{port}/ serving " + o.root);
    HttpOut(Live) closure(HttpRequest) h = lambda(r) { route(o, r) };
    Result(Int, RegionError) served = spawn (network(readonly), filesystem(readonly)) {
        return http_stream_loop(lfd, h, http_limits(), o.requests);
    };
    Int n = served else { -1 };
    return if (n >= 0) { 0 } else { 1 };
}
